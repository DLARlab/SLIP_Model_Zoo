+function row=essentialRow(row)
+% Preserve literal primary science once; old construction catalogues are not
+% an independent result. This same plain-data pack handles saved stage rows
+% and each new fully scouted native source. No source/model is reopened here.
+    if isfield(row,'retention_schema')&&strcmp(row.retention_schema,'C1-audit-essential-row-pack-v2'),return;end
+    if startsWith(row.status,'KEEP_ORIGINAL_COMPACT_FINITE13'),return;end
+    originalPrimary=row.primary_records;
+    for k=1:numel(originalPrimary)
+        r=originalPrimary{k};
+        if isfield(r,'public_properties')
+            r.orbit_facts=orbitFacts(r.public_properties);r=rmfield(r,'public_properties');
+        end
+        row.primary_records{k}=r;
+        original=originalPrimary{k};if isfield(original,'public_properties'),original=rmfield(original,'public_properties');end
+        retained=r;if isfield(retained,'orbit_facts')&&~isfield(original,'orbit_facts'),retained=rmfield(retained,'orbit_facts');end
+        assert(isequaln(original,retained),'AuditFacts:ThinPrimary','Literal primary core, policy, status or diagnostics changed.');
+    end
+    selected={};dropped=0;
+    for k=1:numel(row.selected_final_facts)
+        f=row.selected_final_facts{k};
+        if discardedFactPath(f.path),dropped=dropped+1;continue;end
+        % The original final-fact selector already imposed a native plain
+        % 64KiB bound. Keep each selected noninventory value EXACTLY; the
+        % explicitly labelled plain-primary tables have their original1M cap.
+        selected{end+1,1}=f; %#ok<AGROW>
+    end
+    row.selected_final_facts=selected;
+    row.facts=essentialPlain(row.facts,'facts',0);
+    oldOmissions=row.omissions;row.omissions=omissionSummary(oldOmissions);
+    row.omissions{end+1,1}=struct('path','source construction and execution collections', ...
+        'reason',['After the complete primary-object scout: repeated file/point/source catalogues, graph construction tables, ', ...
+        'provenance copies, dense samples and iteration/evaluation receipts are unavailable. Literal primary cores, ', ...
+        'nonduplicated orbit properties, selected final matrices, current/pending headers and bounded configuration data remain.'], ...
+        'dropped_inventory_or_execution_selected_facts',dropped,'original_omission_entries',numel(oldOmissions));
+    row.retention_schema='C1-audit-essential-row-pack-v2';
+    row.retention_scope=['Historical essential observations only. Retained saved gates and transaction flags are literal, ', ...
+        'not fresh qualification, cleared pending work, physical closure, source-currentness or reproducible old solver tapes.'];
+end
+function out=orbitFacts(values)
+    out=values;if ~isstruct(out),return;end
+    duplicate={'initial_state','initial_mode','parameter','period','stride_displacement','poincare_state', ...
+        'return_policy','return_policy_name','return_multiplicity','section_chart','event_history', ...
+        'event_clusters','floquet_multiplier','stability','primitive_cycle','gait_identification','trajectory'};
+    remove=intersect(fieldnames(out),duplicate);if ~isempty(remove),out=rmfield(out,remove);end
+end
+function out=essentialPlain(v,path,depth)
+% A bounded plain-data header projection. Large arrays of old executions or
+% inventory rows become an explicit shape/count marker, not a new result.
+    assert(depth<=64,'AuditFacts:ThinDepth','Unexpected plain fact depth.');
+    if isstruct(v)
+        if isempty(v),out=v;return;end
+        if ~isscalar(v)&&numel(v)>32&&~transactionPath(path)
+            out=omittedValue(v,'old multi-record execution/inventory collection; primary objects were scouted');return
+        end
+        out=v;
+        for k=1:numel(v)
+            for key=fieldnames(v).'
+                n=key{1};q=v(k).(n);p=sprintf('%s(%d).%s',path,k,n);
+                if (constructionCollection(n)&&~(isnumeric(q)||islogical(q)))||tape(n)||ismember(lower(n),{'public_properties','trajectory','metadata','provenance','full_report','full_receipt'})
+                    out(k).(n)=omittedValue(q,'duplicate construction, trajectory or execution detail after primary scout');
+                else
+                    out(k).(n)=essentialPlain(q,p,depth+1);
+                end
+            end
+        end
+    elseif iscell(v)
+        if numel(v)>32&&~transactionPath(path)
+            out=omittedValue(v,'old cell collection after primary scout');return
+        end
+        out=v;for k=1:numel(v),out{k}=essentialPlain(v{k},sprintf('%s{%d}',path,k),depth+1);end
+    elseif isnumeric(v)||islogical(v)
+        if numel(v)<=4096||(primaryTable(path,v)&&numel(v)<=1000000),out=v;
+        else,out=omittedValue(v,'dense numeric detail; selected final small matrices and primary cores retained separately');end
+    elseif ischar(v)||isstring(v)
+        if numel(v)<=4096,out=v;else,out=omittedValue(v,'long source/console/debug text');end
+    else
+        error('AuditFacts:ThinPlain','Only native-validated plain facts may enter the thin stage: %s.',class(v));
+    end
+end
+function out=omittedValue(v,reason)
